@page
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["PageCSS"] = "about.css";
}

<section class="about">
    <h1>About Me</h1>

    <div class="about-panel bio">
        <p>
            I'm a software developer with a passion for building practical tools, intelligent systems, and immersive digital experiences. Whether it's designing clean architectures, integrating AI-driven features, or creating real-time multiplayer systems, I enjoy solving complex problems with simple, scalable solutions.
        </p>
        <p>
            I take pride in understanding how technologies work under the hood — from building my own authentication systems and APIs to deploying cloud services using Azure Functions. My focus is on writing clean, maintainable code and designing systems that are both robust and user-friendly.
        </p>
        <p>
            Right now, I'm particularly interested in backend architecture, AI-assisted tooling, and systems that blend creativity with engineering — like game engines, interactive web apps, and developer-facing platforms. Most of all, I love the feeling of turning an idea into something real and usable.
        </p>
        <p>
            When I'm not coding, I’m usually sketching ideas, reading about software architecture, or working on side projects that push me to learn something new.
        </p>
    </div>

    <h2>Tech Stack</h2>

    <ul class="about-techicons">
        @foreach (var tech in Portfolio.Stack)
        {
            <li>
                <img src="@tech.Icon" alt="" width="48" height="48" />
                <span>@tech.Name</span>
            </li>
        }
    </ul>

    <h2>Certifications</h2>

    <ul class="certifications-list">
        @foreach (var cert in Portfolio.Certifications)
        {
            <li class="cert-object cert-@cert.Status.ToString().ToLowerInvariant()">
                <img src="@Portfolio.Techs.Azure.Icon" alt="" width="40" height="40" />
                <div>
                    <span class="cert-title">Microsoft Certified: @cert.Name</span>
                    <span class="cert-code">@cert.Code · <partial name="_CertStatus" model="cert.Status" /></span>
                </div>
            </li>
        }
    </ul>
</section>
