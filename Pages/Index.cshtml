@page
@model IndexModel
@{
    ViewData["PageCSS"] = "index.css";
    ViewData["BodyClass"] = "fill-screen";
    var featured = Portfolio.Projects[0];
    var others = Portfolio.Projects.Skip(1).Take(3).ToList();
}

<section class="main-element">

    <div class="main-page-element intro">
        <div class="intro-heading">
            <div class="monogram" aria-hidden="true">JS</div>
            <h1>@Portfolio.Name</h1>
        </div>
        <p class="headline">@Portfolio.Headline</p>
        <partial name="_TechBadges" model="Portfolio.Stack" />
        <p class="blurb">
            I build practical tools and systems, from a Blazor operations dashboard for a medical-equipment
            repair workshop to a C++ / OpenGL graphics engine. I like understanding how things work
            under the hood and turning ideas into something real and usable.
        </p>
        <div class="intro-actions">
            <div class="social-links">
                <a class="social-button" href="@Portfolio.GitHubUrl" aria-label="GitHub" title="GitHub">
                    <img src="~/images/socials/github.png" alt="" width="26" height="26" />
                </a>
                <a class="social-button" href="@Portfolio.LinkedInUrl" aria-label="LinkedIn" title="LinkedIn">
                    <img src="~/images/socials/linkedin.png" alt="" width="26" height="26" />
                </a>
            </div>
            <a class="action-button projects-button" asp-page="/Projects">See my projects <span aria-hidden="true">→</span></a>
        </div>
    </div>

    <article class="main-page-element featured">
        <span class="tile-label">Featured project</span>
        <a href="@featured.GitHubUrl" class="featured-image">
            <img src="@featured.Image" alt="@featured.ImageAlt" loading="lazy" />
        </a>
        <h2>@featured.Title</h2>
        <p>@featured.Description</p>
        <div class="action-links">
            @if (featured.LiveUrl != null)
            {
                <a class="action-button" href="@featured.LiveUrl">Live demo</a>
            }
            <a class="action-button secondary" href="@featured.GitHubUrl">Code on GitHub</a>
        </div>
    </article>

    @for (var i = 0; i < others.Count; i++)
    {
        var project = others[i];
        <a class="main-page-element project-tile p@(i + 1)" href="@(project.PrimaryUrl ?? $"/projects#{project.Slug}")">
            <h2>
                @project.Title
                @if (project.InProgress)
                {
                    <span class="status-pill">In progress</span>
                }
            </h2>
            <p>@project.Summary</p>
            <partial name="_TechBadges" model="project.Stack.Take(3)" />
        </a>
    }

    <div class="side-column">
        @for (var i = 0; i < Portfolio.Certifications.Count; i++)
        {
            var cert = Portfolio.Certifications[i];
            <div class="main-page-element cert-tile cert-@cert.Status.ToString().ToLowerInvariant() c@(i + 1)">
                <img src="@Portfolio.Techs.Azure.Icon" alt="" width="32" height="32" />
                <div class="cert-text">
                    <h2>@cert.Name</h2>
                    <p>
                        @cert.Code ·
                        <partial name="_CertStatus" model="cert.Status" />
                    </p>
                </div>
            </div>
        }

        <a class="main-page-element contact-tile" asp-page="/Contact">
            <h2>Get in touch<span class="tile-arrow" aria-hidden="true">→</span></h2>
            <p>Open to internship and job opportunities.</p>
        </a>
    </div>

</section>
