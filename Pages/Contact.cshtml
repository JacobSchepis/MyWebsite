@page
@model ContactModel
@{
    ViewData["Title"] = "Contact";
    ViewData["PageCSS"] = "contact.css";
}
<section class="contact">
    <h1>Contact Me</h1>
    <p class="contact-intro">
        I'm open to internship and job opportunities. The best way to reach me is a message on LinkedIn.
    </p>

    <ul class="contact-links">
        <li>
            <a href="@Portfolio.LinkedInUrl" class="contact-card">
                <img src="~/images/socials/linkedin.png" alt="" width="40" height="40" />
                <span>
                    <strong>LinkedIn</strong>
                    <span>linkedin.com/in/jacob-schepis</span>
                </span>
            </a>
        </li>
        <li>
            <a href="@Portfolio.GitHubUrl" class="contact-card">
                <img src="~/images/socials/github.png" alt="" width="40" height="40" />
                <span>
                    <strong>GitHub</strong>
                    <span>github.com/JacobSchepis</span>
                </span>
            </a>
        </li>
    </ul>
</section>
