@model IEnumerable<Tech>

<ul class="tech-badges">
    @foreach (var tech in Model)
    {
        <li class="tech-badge">
            @if (tech.Icon != null)
            {
                <img src="@tech.Icon" alt="" width="18" height="18" />
            }
            <span>@tech.Name</span>
        </li>
    }
</ul>
