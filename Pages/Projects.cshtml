@page
@model MyWebsite.Pages.ProjectsModel
@{
    ViewData["Title"] = "Projects";
    ViewData["PageCSS"] = "projects.css";
}

<section>

    <h1>My Projects</h1>

    <div class="projects-grid">
        @foreach (var project in Portfolio.Projects)
        {
            <article class="project" id="@project.Slug">
                @if (project.Image != null && (project.LiveUrl ?? project.GitHubUrl) is string imageLink)
                {
                    <a href="@imageLink" class="project-image">
                        <img src="@project.Image" alt="@project.ImageAlt" loading="lazy" />
                    </a>
                }
                else if (project.Image != null)
                {
                    <div class="project-image">
                        <img src="@project.Image" alt="@project.ImageAlt" loading="lazy" />
                    </div>
                }
                else
                {
                    <div class="project-banner" aria-hidden="true">
                        @foreach (var tech in project.Stack.Where(t => t.Icon != null).Take(2))
                        {
                            <img src="@tech.Icon" alt="" width="64" height="64" />
                        }
                    </div>
                }
                <div class="project-body">
                    <h2>
                        @project.Title
                        @if (project.InProgress)
                        {
                            <span class="status-pill">In progress</span>
                        }
                    </h2>
                    <p>@project.Description</p>
                    <partial name="_TechBadges" model="project.Stack" />
                    @if (project.LiveUrl != null || project.GitHubUrl != null)
                    {
                        <div class="action-links">
                            @if (project.LiveUrl != null)
                            {
                                <a class="action-button" href="@project.LiveUrl">@project.LiveLabel</a>
                            }
                            @if (project.GitHubUrl != null)
                            {
                                <a class="action-button secondary" href="@project.GitHubUrl">Code on GitHub</a>
                            }
                        </div>
                    }
                </div>
            </article>
        }
    </div>
</section>
